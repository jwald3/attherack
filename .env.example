# Copy to .env and fill in, or just export these in your shell.

# Enables the Claude coach. Bring your own key from https://console.anthropic.com
# Leave unset to run without the AI coach.
ANTHROPIC_API_KEY=

# Listen address (default 127.0.0.1:8080, this computer only)
# ADDR=127.0.0.1:8080
# To reach the app from other devices on your network, use ADDR=:8080.
# There is no login, so only do that on a network you trust.

# SQLite database file (default attherack.db, created on first run)
# DB_PATH=attherack.db
